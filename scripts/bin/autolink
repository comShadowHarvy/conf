#!/usr/bin/env bash
# ==============================================================================
# autolink - Dual Wi-Fi Failover & Speed-Based Routing Manager (nmcli)
# ==============================================================================
# Connects secondary Wi-Fi adapter(s) to the same network as your primary active
# Wi-Fi adapter using cloned NetworkManager profiles with failover route metrics,
# and optionally benchmarks connected Wi-Fi adapters to temporarily promote the
# fastest one as the default route.
# ==============================================================================

set -euo pipefail

readonly PROG_NAME="${0##*/}"
readonly PROFILE_PREFIX="autolink-"

# Defaults
ACTION="up"
PRIMARY_IFACE=""
SECONDARY_IFACE=""
LINK_ALL=false
PRIMARY_METRIC=100
SECONDARY_METRIC=200
METRIC_STEP=100
AUTOCONNECT="no"
KEEP_PROFILE=false
DRY_RUN=false

# Speedtest options
RUN_FASTEST=false
SPEED_URL="https://speed.cloudflare.com/__down?bytes=10000000"
SPEED_TIMEOUT=8
SPEED_PERSIST=false
SPEED_NO_APPLY=false

# Colors (disabled when piped or NO_COLOR is set)
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_CYAN=$'\033[36m'
  C_DIM=$'\033[2m'
else
  C_RESET="" C_BOLD="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_CYAN="" C_DIM=""
fi

info()    { printf '%b[INFO]%b %s\n'  "$C_BLUE"   "$C_RESET" "$*"; }
ok()      { printf '%b[OK]%b %s\n'    "$C_GREEN"  "$C_RESET" "$*"; }
warn()    { printf '%b[WARN]%b %s\n'  "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()     { printf '%b[ERROR]%b %s\n' "$C_RED"    "$C_RESET" "$*" >&2; }
die()     { err "$@"; exit 1; }

usage() {
  cat <<EOF
${C_BOLD}Usage:${C_RESET}
  ${PROG_NAME} [command] [options]

${C_BOLD}Commands:${C_RESET}
  up, connect              Connect secondary Wi-Fi adapter(s) in failover mode (default)
  down, disconnect         Disconnect and remove ${PROFILE_PREFIX}* failover profile(s)
  speedtest, bench         Test download speed per connected Wi-Fi adapter and temporarily
                           promote the fastest as the default route
  status                   Show Wi-Fi interfaces, profiles, IPs, and default route metrics

${C_BOLD}Options:${C_RESET}
  -p, --primary IFACE         Primary (active) Wi-Fi interface (auto-detected if omitted)
  -s, --secondary IFACE       Secondary (target) Wi-Fi interface (auto-detected if omitted)
  -a, --all                   Link all idle Wi-Fi interfaces (increments metric per adapter)
  -f, --fastest               With 'up', run speedtest after linking and temporarily make
                              the fastest Wi-Fi adapter the default route
      --primary-metric N      Route metric for primary/fastest adapter (default: ${PRIMARY_METRIC})
      --secondary-metric N    Route metric for secondary adapter(s) (default: ${SECONDARY_METRIC})
      --autoconnect           Allow cloned failover profile(s) to auto-connect
      --keep-profile          With 'down', disconnect without deleting ${PROFILE_PREFIX}* profiles
      --speed-url URL         Download URL for speedtest (default: 10MB Cloudflare test)
      --speed-timeout SEC     Max seconds per interface speedtest (default: ${SPEED_TIMEOUT})
      --persist               With 'speedtest'/'--fastest', save winning metrics to profiles
                              instead of applying them temporarily in runtime only
      --no-apply              With 'speedtest', print results without changing route metrics
  -n, --dry-run               Show commands that would run without making changes
  -h, --help                  Show this help message

${C_BOLD}Examples:${C_RESET}
  ${PROG_NAME}                              # Auto-detect adapters and enable failover
  ${PROG_NAME} up --fastest                 # Link secondary adapter, test speeds, set fastest as temp default
  ${PROG_NAME} speedtest                    # Benchmark connected Wi-Fi cards & temporarily promote fastest
  ${PROG_NAME} speedtest --no-apply         # Benchmark only without changing routes
  ${PROG_NAME} speedtest --persist          # Benchmark and save winning metrics to profiles
  ${PROG_NAME} --dry-run                    # Preview actions without modifying NetworkManager
  ${PROG_NAME} -p wlan0 -s wlan1            # Explicitly pick primary and secondary adapters
  ${PROG_NAME} status                       # Inspect interfaces and route metrics
  ${PROG_NAME} down                         # Tear down failover connections and profiles
EOF
}

# Unescape nmcli terse output (\: -> :, \\ -> \)
nmcli_unescape() {
  local s="$1"
  s="${s//\\:/:}"
  s="${s//\\\\/\\}"
  printf '%s' "$s"
}

validate_metric() {
  local name="$1" val="$2"
  if [[ ! "$val" =~ ^[0-9]+$ ]] || (( val > 4294967295 )); then
    die "Invalid ${name} metric '${val}': must be an integer between 0 and 4294967295."
  fi
}

validate_positive_int() {
  local name="$1" val="$2"
  if [[ ! "$val" =~ ^[1-9][0-9]*$ ]]; then
    die "Invalid ${name} '${val}': must be a positive integer."
  fi
}

run_cmd() {
  if [[ "$DRY_RUN" == true ]]; then
    printf '%b[DRY-RUN]%b' "$C_CYAN" "$C_RESET"
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

check_deps() {
  command -v nmcli >/dev/null 2>&1 || die "nmcli is not installed. Please install NetworkManager."
  local running
  running="$(nmcli -t -f RUNNING general 2>/dev/null || true)"
  if [[ "$running" != "running" ]]; then
    die "NetworkManager is not running or unreachable."
  fi
}

check_speedtest_deps() {
  command -v curl >/dev/null 2>&1 || die "curl is required for speedtest."
  command -v awk  >/dev/null 2>&1 || die "awk is required for speedtest."
}

# Query a single NetworkManager property cleanly
nm_dev_prop() {
  local iface="$1" prop="$2"
  nmcli -g "$prop" device show "$iface" 2>/dev/null | head -n 1 || true
}

nm_con_prop() {
  local uuid="$1" prop="$2"
  nmcli -g "$prop" connection show uuid "$uuid" 2>/dev/null | head -n 1 || true
}

# Get the active kernel default IPv4 route metric for a device (empty if none)
live_route_metric() {
  local iface="$1" route_line
  if ! command -v ip >/dev/null 2>&1; then
    return 0
  fi
  route_line="$(ip -4 route show default dev "$iface" 2>/dev/null | head -n 1 || true)"
  if [[ "$route_line" =~ metric[[:space:]]+([0-9]+) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

# Populate associative arrays of all Wi-Fi devices and their states
declare -A WIFI_STATES=()
declare -a WIFI_IFACES=()

load_wifi_devices() {
  WIFI_STATES=()
  WIFI_IFACES=()
  local line dev_type dev_state dev_name
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    # TYPE and STATE do not contain colons; DEVICE is the remainder
    dev_type="${line%%:*}"
    local rest="${line#*:}"
    dev_state="${rest%%:*}"
    dev_name="$(nmcli_unescape "${rest#*:}")"
    if [[ "$dev_type" == "wifi" && -n "$dev_name" ]]; then
      WIFI_IFACES+=("$dev_name")
      WIFI_STATES["$dev_name"]="$dev_state"
    fi
  done < <(nmcli -t -f TYPE,STATE,DEVICE device status 2>/dev/null || true)
}

# Find all connection UUIDs matching a given name (or prefix if mode="prefix")
find_con_uuids() {
  local pattern="$1" mode="${2:-exact}"
  local line uuid name
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    uuid="${line%%:*}"
    name="$(nmcli_unescape "${line#*:}")"
    if [[ "$mode" == "prefix" ]]; then
      [[ "$name" == "${pattern}"* ]] && printf '%s\n' "$uuid"
    else
      [[ "$name" == "$pattern" ]] && printf '%s\n' "$uuid"
    fi
  done < <(nmcli -t -f UUID,NAME connection show 2>/dev/null || true)
}

is_con_active() {
  local target_uuid="$1"
  local uuid
  while IFS= read -r uuid; do
    [[ "$uuid" == "$target_uuid" ]] && return 0
  done < <(nmcli -t -f UUID connection show --active 2>/dev/null || true)
  return 1
}

# Set IPv4/IPv6 route metrics persistently on a connection UUID when enabled
apply_profile_metrics() {
  local uuid="$1" metric="$2" iface="$3" reapply="${4:-false}"
  local ipv4_method ipv6_method cur_v4 cur_v6
  local -a mod_args=()

  ipv4_method="$(nm_con_prop "$uuid" ipv4.method)"
  ipv6_method="$(nm_con_prop "$uuid" ipv6.method)"
  cur_v4="$(nm_con_prop "$uuid" ipv4.route-metric)"
  cur_v6="$(nm_con_prop "$uuid" ipv6.route-metric)"

  if [[ "$ipv4_method" != "disabled" && "$ipv4_method" != "ignore" && "$cur_v4" != "$metric" ]]; then
    mod_args+=(ipv4.route-metric "$metric")
  fi
  if [[ "$ipv6_method" != "disabled" && "$ipv6_method" != "ignore" && "$cur_v6" != "$metric" ]]; then
    mod_args+=(ipv6.route-metric "$metric")
  fi

  if (( ${#mod_args[@]} == 0 )); then
    info "Profile metrics on ${iface} already set to ${metric}."
    return 0
  fi

  info "Setting saved route metric=${metric} on ${iface}..."
  run_cmd nmcli connection modify uuid "$uuid" "${mod_args[@]}"
  if [[ "$reapply" == true ]]; then
    run_cmd nmcli device reapply "$iface"
  fi
}

# Set IPv4/IPv6 route metrics temporarily on the active device (does not modify saved profile)
apply_runtime_metrics() {
  local uuid="$1" metric="$2" iface="$3"
  local ipv4_method ipv6_method
  local -a mod_args=()

  ipv4_method="$(nm_con_prop "$uuid" ipv4.method)"
  ipv6_method="$(nm_con_prop "$uuid" ipv6.method)"

  if [[ "$ipv4_method" != "disabled" && "$ipv4_method" != "ignore" ]]; then
    mod_args+=(ipv4.route-metric "$metric")
  fi
  if [[ "$ipv6_method" != "disabled" && "$ipv6_method" != "ignore" ]]; then
    mod_args+=(ipv6.route-metric "$metric")
  fi

  if (( ${#mod_args[@]} == 0 )); then
    warn "No IPv4/IPv6 addressing enabled on ${iface}; skipping metric update."
    return 0
  fi

  info "Setting temporary route metric=${metric} on ${iface} (runtime only)..."
  run_cmd nmcli device modify "$iface" "${mod_args[@]}"
}

# Wait briefly for an interface to obtain an IP address after activation
wait_for_ip() {
  local iface="$1" tries=10 ip4 ip6
  while (( tries > 0 )); do
    ip4="$(nm_dev_prop "$iface" 'IP4.ADDRESS[1]')"
    ip6="$(nm_dev_prop "$iface" 'IP6.ADDRESS[1]')"
    if [[ -n "$ip4" || -n "$ip6" ]]; then
      return 0
    fi
    sleep 0.5
    tries=$(( tries - 1 ))
  done
  warn "Timed out waiting for IP address on ${iface}."
  return 1
}

# Measure download throughput for a single interface via curl --interface
# Outputs tab-separated: bytes_per_sec  ttfb_sec  mbps  ttfb_ms  status_label
measure_iface_speed() {
  local iface="$1"
  local out rc=0 speed_bps ttfb size_bytes http_code mbps ttfb_ms

  out="$(
    curl --interface "$iface" \
      -L -s -S -o /dev/null \
      --connect-timeout 5 \
      --max-time "$SPEED_TIMEOUT" \
      -w '%{speed_download}\t%{time_starttransfer}\t%{size_download}\t%{http_code}' \
      "$SPEED_URL" 2>/dev/null
  )" || rc=$?

  IFS=$'\t' read -r speed_bps ttfb size_bytes http_code <<< "$out"
  speed_bps="${speed_bps:-0}"
  ttfb="${ttfb:-999}"
  size_bytes="${size_bytes:-0}"
  http_code="${http_code:-000}"

  # Exit code 28 (timeout) is valid if we already downloaded data with an HTTP 2xx response
  local valid=false
  if [[ "$http_code" =~ ^2[0-9][0-9]$ ]] && (( size_bytes > 0 )); then
    if (( rc == 0 || rc == 28 )); then
      valid=true
    fi
  fi

  if [[ "$valid" == true ]]; then
    mbps="$(awk -v bps="$speed_bps" 'BEGIN { printf "%.2f", (bps * 8) / 1000000 }')"
    ttfb_ms="$(awk -v t="$ttfb" 'BEGIN { printf "%.0f", t * 1000 }')"
    printf '%s\t%s\t%s\t%s\tok\n' "$speed_bps" "$ttfb" "$mbps" "$ttfb_ms"
  else
    printf '0\t999\t0.00\t-\tfailed(rc=%d,http=%s)\n' "$rc" "$http_code"
  fi
}

cmd_speedtest() {
  check_speedtest_deps
  load_wifi_devices

  if (( ${#WIFI_IFACES[@]} == 0 )); then
    die "No Wi-Fi interfaces found on this system."
  fi

  local -a connected=()
  local dev
  for dev in "${WIFI_IFACES[@]}"; do
    if [[ "${WIFI_STATES[$dev]}" == "connected" ]]; then
      connected+=("$dev")
    fi
  done

  if (( ${#connected[@]} == 0 )); then
    die "No connected Wi-Fi interfaces found to benchmark."
  fi

  info "Benchmarking ${#connected[@]} connected Wi-Fi adapter(s) (timeout: ${SPEED_TIMEOUT}s each)..."
  info "Test URL: ${SPEED_URL}"

  local -a raw_results=()
  local res speed_bps ttfb mbps ttfb_ms st
  for dev in "${connected[@]}"; do
    printf '  Testing %b%s%b ... ' "$C_BOLD" "$dev" "$C_RESET"
    res="$(measure_iface_speed "$dev")"
    IFS=$'\t' read -r speed_bps ttfb mbps ttfb_ms st <<< "$res"
    if [[ "$st" == "ok" ]]; then
      printf '%b%s Mbps%b (TTFB: %s ms)\n' "$C_GREEN" "$mbps" "$C_RESET" "$ttfb_ms"
    else
      printf '%b%s%b\n' "$C_RED" "$st" "$C_RESET"
    fi
    raw_results+=("${speed_bps}"$'\t'"${ttfb}"$'\t'"${dev}"$'\t'"${mbps}"$'\t'"${ttfb_ms}"$'\t'"${st}")
  done

  # Sort fastest first (speed_bps desc, then ttfb asc)
  local -a ranked=()
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && ranked+=("$line")
  done < <(printf '%s\n' "${raw_results[@]}" | sort -t$'\t' -k1,1gr -k2,2g)

  printf '\n%b%-6s %-14s %-14s %-12s %s%b\n' \
    "$C_BOLD" "RANK" "INTERFACE" "DOWNLOAD" "TTFB" "STATUS" "$C_RESET"
  printf '%b%s%b\n' "$C_DIM" "----------------------------------------------------------------" "$C_RESET"

  local rank=1
  local -a ranked_ifaces=()
  local best_iface="" best_mbps="" best_ok=false
  for line in "${ranked[@]}"; do
    IFS=$'\t' read -r speed_bps ttfb dev mbps ttfb_ms st <<< "$line"
    printf '#%-5d %-14s %-14s %-12s %s\n' \
      "$rank" "$dev" "${mbps} Mbps" "${ttfb_ms} ms" "$st"
    ranked_ifaces+=("$dev")
    if (( rank == 1 )) && [[ "$st" == "ok" ]]; then
      best_iface="$dev"
      best_mbps="$mbps"
      best_ok=true
    fi
    rank=$(( rank + 1 ))
  done
  printf '\n'

  if [[ "$best_ok" == false ]]; then
    die "All speed tests failed; route metrics were not changed."
  fi

  if [[ "$SPEED_NO_APPLY" == true ]]; then
    ok "Fastest adapter: ${best_iface} (${best_mbps} Mbps) — no route changes applied (--no-apply)."
    return 0
  fi

  if (( ${#ranked_ifaces[@]} < 2 )); then
    ok "Only one connected Wi-Fi adapter (${best_iface}: ${best_mbps} Mbps); nothing to reprioritize."
    return 0
  fi

  if (( PRIMARY_METRIC >= SECONDARY_METRIC )); then
    warn "Primary metric (${PRIMARY_METRIC}) >= secondary metric (${SECONDARY_METRIC}); ranking may not match expected failover order."
  fi

  local idx=0 metric uuid
  for dev in "${ranked_ifaces[@]}"; do
    if (( idx == 0 )); then
      metric="$PRIMARY_METRIC"
    else
      metric=$(( SECONDARY_METRIC + (idx - 1) * METRIC_STEP ))
    fi
    uuid="$(nm_dev_prop "$dev" GENERAL.CON-UUID)"
    if [[ -z "$uuid" || "$uuid" == "--" ]]; then
      warn "Could not find active connection UUID for ${dev}; skipping."
      idx=$(( idx + 1 ))
      continue
    fi

    if [[ "$SPEED_PERSIST" == true ]]; then
      apply_profile_metrics "$uuid" "$metric" "$dev" true
    else
      apply_runtime_metrics "$uuid" "$metric" "$dev"
    fi
    idx=$(( idx + 1 ))
  done

  if [[ "$DRY_RUN" == true ]]; then
    info "Dry run complete — no route metrics were changed."
  elif [[ "$SPEED_PERSIST" == true ]]; then
    ok "Saved ${best_iface} (${best_mbps} Mbps) as persistent default (metric ${PRIMARY_METRIC})."
  else
    ok "Set ${best_iface} (${best_mbps} Mbps) as temporary default (metric ${PRIMARY_METRIC}; resets on reconnect/reboot)."
  fi
}

cmd_up() {
  load_wifi_devices

  if (( ${#WIFI_IFACES[@]} == 0 )); then
    die "No Wi-Fi interfaces found on this system."
  fi

  if (( PRIMARY_METRIC >= SECONDARY_METRIC )); then
    warn "Primary metric (${PRIMARY_METRIC}) >= secondary metric (${SECONDARY_METRIC}); secondary may take precedence over primary."
  fi

  # 1. Resolve primary Wi-Fi interface
  local primary="$PRIMARY_IFACE"
  if [[ -n "$primary" ]]; then
    if [[ -z "${WIFI_STATES[$primary]+x}" ]]; then
      die "Primary interface '${primary}' is not a Wi-Fi device."
    fi
    if [[ "${WIFI_STATES[$primary]}" != "connected" ]]; then
      die "Primary interface '${primary}' is not connected (state: ${WIFI_STATES[$primary]})."
    fi
  else
    local dev con_name
    for dev in "${WIFI_IFACES[@]}"; do
      if [[ "${WIFI_STATES[$dev]}" == "connected" ]]; then
        con_name="$(nmcli_unescape "$(nm_dev_prop "$dev" GENERAL.CONNECTION)")"
        # Skip existing autolink failover interfaces when choosing the primary
        if [[ "$con_name" != "${PROFILE_PREFIX}"* ]]; then
          primary="$dev"
          break
        fi
      fi
    done
    if [[ -z "$primary" ]]; then
      die "No active primary Wi-Fi connection found."
    fi
  fi

  local primary_uuid primary_con primary_ssid
  primary_uuid="$(nm_dev_prop "$primary" GENERAL.CON-UUID)"
  primary_con="$(nmcli_unescape "$(nm_dev_prop "$primary" GENERAL.CONNECTION)")"
  if [[ -z "$primary_uuid" ]]; then
    die "Could not determine active NetworkManager connection UUID for '${primary}'."
  fi
  primary_ssid="$(nmcli_unescape "$(nm_con_prop "$primary_uuid" 802-11-wireless.ssid)")"
  [[ -z "$primary_ssid" ]] && primary_ssid="$primary_con"

  ok "Primary Wi-Fi: ${primary} -> SSID '${primary_ssid}' (profile: ${primary_con})"

  # 2. Resolve secondary Wi-Fi interface(s)
  local -a targets=()
  if [[ -n "$SECONDARY_IFACE" ]]; then
    if [[ -z "${WIFI_STATES[$SECONDARY_IFACE]+x}" ]]; then
      die "Secondary interface '${SECONDARY_IFACE}' is not a Wi-Fi device."
    fi
    if [[ "$SECONDARY_IFACE" == "$primary" ]]; then
      die "Secondary interface cannot be the same as primary ('${primary}')."
    fi
    local sec_state="${WIFI_STATES[$SECONDARY_IFACE]}"
    if [[ "$sec_state" == "unavailable" || "$sec_state" == "unmanaged" ]]; then
      die "Secondary interface '${SECONDARY_IFACE}' is ${sec_state} (check rfkill / Wi-Fi radio)."
    fi
    targets+=("$SECONDARY_IFACE")
  else
    local dev
    for dev in "${WIFI_IFACES[@]}"; do
      [[ "$dev" == "$primary" ]] && continue
      if [[ "${WIFI_STATES[$dev]}" == "disconnected" ]]; then
        targets+=("$dev")
        [[ "$LINK_ALL" == false ]] && break
      fi
    done

    if (( ${#targets[@]} == 0 )); then
      if (( ${#WIFI_IFACES[@]} < 2 )); then
        die "Only one Wi-Fi interface (${primary}) detected; a second Wi-Fi adapter is required."
      fi
      warn "No idle Wi-Fi interfaces found (other adapters may already be connected or unavailable)."
      if [[ "$RUN_FASTEST" == true ]]; then
        info "Running speedtest on currently connected Wi-Fi adapters..."
        cmd_speedtest
        return 0
      fi
      info "Run '${PROG_NAME} status' to inspect all Wi-Fi interfaces, or '${PROG_NAME} speedtest' to rank connected ones."
      return 0
    fi
  fi

  # 3. Ensure primary has the lower failover metric
  apply_profile_metrics "$primary_uuid" "$PRIMARY_METRIC" "$primary" true

  # 4. Clone and connect each secondary interface
  local idx=0 sec_iface sec_metric clone_name existing_uuid clone_uuid
  local ipv4_method ipv6_method
  ipv4_method="$(nm_con_prop "$primary_uuid" ipv4.method)"
  ipv6_method="$(nm_con_prop "$primary_uuid" ipv6.method)"

  for sec_iface in "${targets[@]}"; do
    sec_metric=$(( SECONDARY_METRIC + idx * METRIC_STEP ))
    clone_name="${PROFILE_PREFIX}${sec_iface}"
    idx=$(( idx + 1 ))

    info "Configuring failover on ${sec_iface} (profile: ${clone_name}, metric: ${sec_metric})..."

    # Remove any previous autolink profile for this interface to prevent duplicates/stale SSIDs
    while IFS= read -r existing_uuid; do
      [[ -z "$existing_uuid" ]] && continue
      if is_con_active "$existing_uuid"; then
        run_cmd nmcli connection down uuid "$existing_uuid"
      fi
      run_cmd nmcli connection delete uuid "$existing_uuid"
    done < <(find_con_uuids "$clone_name" exact)

    # Clone preserves security credentials (WPA2/WPA3/802.1X) without re-prompting
    run_cmd nmcli connection clone "$primary_uuid" "$clone_name"

    local -a clone_mod=(
      connection.interface-name "$sec_iface"
      connection.autoconnect "$AUTOCONNECT"
      802-11-wireless.mac-address ""
    )
    if [[ "$ipv4_method" != "disabled" && "$ipv4_method" != "ignore" ]]; then
      clone_mod+=(ipv4.route-metric "$sec_metric")
    fi
    if [[ "$ipv6_method" != "disabled" && "$ipv6_method" != "ignore" ]]; then
      clone_mod+=(ipv6.route-metric "$sec_metric")
    fi

    if [[ "$DRY_RUN" == true ]]; then
      run_cmd nmcli connection modify "$clone_name" "${clone_mod[@]}"
      run_cmd nmcli connection up "$clone_name" ifname "$sec_iface"
    else
      clone_uuid="$(find_con_uuids "$clone_name" exact | head -n 1)"
      [[ -n "$clone_uuid" ]] || die "Failed to locate cloned profile '${clone_name}'."
      nmcli connection modify uuid "$clone_uuid" "${clone_mod[@]}"
      nmcli connection up uuid "$clone_uuid" ifname "$sec_iface"
    fi

    ok "Linked ${sec_iface} -> '${primary_ssid}' (failover metric ${sec_metric})"
  done

  if [[ "$DRY_RUN" == true ]]; then
    if [[ "$RUN_FASTEST" == true ]]; then
      printf '%b[DRY-RUN]%b Would run speedtest across connected Wi-Fi adapters and set the fastest as temporary default (metric %s).\n' \
        "$C_CYAN" "$C_RESET" "$PRIMARY_METRIC"
    fi
    info "Dry run complete — no changes were applied."
    return 0
  fi

  local sec_label="metric ${SECONDARY_METRIC}"
  (( ${#targets[@]} > 1 )) && sec_label="metric ${SECONDARY_METRIC}+"
  ok "Failover ready: ${primary} (metric ${PRIMARY_METRIC}) -> ${targets[*]} (${sec_label})"

  if [[ "$RUN_FASTEST" == true ]]; then
    for sec_iface in "${targets[@]}"; do
      wait_for_ip "$sec_iface" || true
    done
    printf '\n'
    cmd_speedtest
  fi
}

cmd_down() {
  local -a uuids=()
  local u

  if [[ -n "$SECONDARY_IFACE" ]]; then
    while IFS= read -r u; do
      [[ -n "$u" ]] && uuids+=("$u")
    done < <(find_con_uuids "${PROFILE_PREFIX}${SECONDARY_IFACE}" exact)
  else
    while IFS= read -r u; do
      [[ -n "$u" ]] && uuids+=("$u")
    done < <(find_con_uuids "$PROFILE_PREFIX" prefix)
  fi

  if (( ${#uuids[@]} == 0 )); then
    info "No ${PROFILE_PREFIX}* failover profiles found."
    return 0
  fi

  local name
  for u in "${uuids[@]}"; do
    name="$(nmcli_unescape "$(nm_con_prop "$u" connection.id)")"
    if is_con_active "$u"; then
      info "Disconnecting ${name}..."
      run_cmd nmcli connection down uuid "$u"
    fi
    if [[ "$KEEP_PROFILE" == false ]]; then
      info "Removing profile ${name}..."
      run_cmd nmcli connection delete uuid "$u"
    fi
  done

  if [[ "$DRY_RUN" == true ]]; then
    info "Dry run complete — no changes were applied."
  elif [[ "$KEEP_PROFILE" == true ]]; then
    ok "Disconnected failover connection(s) (profiles kept)."
  else
    ok "Disconnected and removed ${#uuids[@]} failover profile(s)."
  fi
}

cmd_status() {
  load_wifi_devices

  if (( ${#WIFI_IFACES[@]} == 0 )); then
    warn "No Wi-Fi interfaces found."
    return 0
  fi

  printf '%b%-14s %-14s %-10s %-22s %-18s %-18s %s%b\n' \
    "$C_BOLD" "INTERFACE" "STATE" "ROLE" "PROFILE" "SSID" "IPv4" "METRIC" "$C_RESET"
  printf '%b%s%b\n' "$C_DIM" "------------------------------------------------------------------------------------------------------------" "$C_RESET"

  local dev state uuid con_name ssid ipv4 prof_metric live_metric metric_display role
  for dev in "${WIFI_IFACES[@]}"; do
    state="${WIFI_STATES[$dev]}"
    uuid="$(nm_dev_prop "$dev" GENERAL.CON-UUID)"
    con_name="$(nmcli_unescape "$(nm_dev_prop "$dev" GENERAL.CONNECTION)")"
    ipv4="$(nm_dev_prop "$dev" 'IP4.ADDRESS[1]')"
    ssid="-"
    metric_display="-"
    role="idle"

    if [[ -n "$uuid" && "$uuid" != "--" ]]; then
      ssid="$(nmcli_unescape "$(nm_con_prop "$uuid" 802-11-wireless.ssid)")"
      prof_metric="$(nm_con_prop "$uuid" ipv4.route-metric)"
      live_metric="$(live_route_metric "$dev")"

      if [[ -n "$live_metric" ]]; then
        if [[ -n "$prof_metric" && "$prof_metric" != "-1" && "$live_metric" != "$prof_metric" ]]; then
          metric_display="${live_metric} (temp)"
        else
          metric_display="$live_metric"
        fi
      elif [[ "$prof_metric" == "-1" || -z "$prof_metric" ]]; then
        metric_display="auto"
      else
        metric_display="$prof_metric"
      fi

      if [[ "$con_name" == "${PROFILE_PREFIX}"* ]]; then
        role="failover"
      elif [[ "$state" == "connected" ]]; then
        role="primary"
      else
        role="other"
      fi
    elif [[ "$state" != "disconnected" ]]; then
      role="$state"
    fi

    [[ -z "$con_name" || "$con_name" == "--" ]] && con_name="-"
    [[ -z "$ssid" ]] && ssid="-"
    [[ -z "$ipv4" ]] && ipv4="-"

    printf '%-14s %-14s %-10s %-22s %-18s %-18s %s\n' \
      "$dev" "$state" "$role" "$con_name" "$ssid" "$ipv4" "$metric_display"
  done

  if command -v ip >/dev/null 2>&1; then
    local routes
    routes="$(ip -4 route show default 2>/dev/null || true)"
    if [[ -n "$routes" ]]; then
      printf '\n%bDefault IPv4 routes (lowest metric wins):%b\n' "$C_BOLD" "$C_RESET"
      printf '%s\n' "$routes"
    fi
  fi
}

parse_args() {
  if (( $# > 0 )); then
    case "$1" in
      up|connect)
        ACTION="up"
        shift
        ;;
      down|disconnect)
        ACTION="down"
        shift
        ;;
      speedtest|bench|fastest)
        ACTION="speedtest"
        shift
        ;;
      status)
        ACTION="status"
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
    esac
  fi

  while (( $# > 0 )); do
    case "$1" in
      -p|--primary)
        [[ $# -ge 2 ]] || die "Option '$1' requires an interface name."
        PRIMARY_IFACE="$2"
        shift 2
        ;;
      -s|--secondary)
        [[ $# -ge 2 ]] || die "Option '$1' requires an interface name."
        SECONDARY_IFACE="$2"
        shift 2
        ;;
      -a|--all)
        LINK_ALL=true
        shift
        ;;
      -f|--fastest)
        RUN_FASTEST=true
        shift
        ;;
      --primary-metric)
        [[ $# -ge 2 ]] || die "Option '$1' requires a numeric value."
        PRIMARY_METRIC="$2"
        shift 2
        ;;
      --secondary-metric)
        [[ $# -ge 2 ]] || die "Option '$1' requires a numeric value."
        SECONDARY_METRIC="$2"
        shift 2
        ;;
      --autoconnect)
        AUTOCONNECT="yes"
        shift
        ;;
      --keep-profile)
        KEEP_PROFILE=true
        shift
        ;;
      --speed-url)
        [[ $# -ge 2 ]] || die "Option '$1' requires a URL."
        SPEED_URL="$2"
        shift 2
        ;;
      --speed-timeout)
        [[ $# -ge 2 ]] || die "Option '$1' requires a timeout in seconds."
        SPEED_TIMEOUT="$2"
        shift 2
        ;;
      --persist)
        SPEED_PERSIST=true
        shift
        ;;
      --no-apply)
        SPEED_NO_APPLY=true
        shift
        ;;
      -n|--dry-run)
        DRY_RUN=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: '$1'. Use --help for usage."
        ;;
    esac
  done

  validate_metric "primary" "$PRIMARY_METRIC"
  validate_metric "secondary" "$SECONDARY_METRIC"
  validate_positive_int "speed timeout" "$SPEED_TIMEOUT"
}

main() {
  parse_args "$@"
  check_deps

  case "$ACTION" in
    up)        cmd_up ;;
    down)      cmd_down ;;
    speedtest) cmd_speedtest ;;
    status)    cmd_status ;;
  esac
}

main "$@"
