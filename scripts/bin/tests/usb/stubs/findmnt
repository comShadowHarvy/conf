#!/usr/bin/env python3
"""Fake findmnt: answers "--source DEV" from $FAKE_STATE/mounted."""
import os, sys
st = os.environ["FAKE_STATE"]
a = sys.argv[1:]
dev = a[a.index("--source") + 1] if "--source" in a else (a[-1] if a else "")
p = os.path.join(st, "mounted")
rows = [l.split(None, 1) for l in open(p).read().splitlines() if l.strip()] if os.path.exists(p) else []
for d, m in rows:
    if d == dev:
        print(m)
        sys.exit(0)
sys.exit(1)
